# Add dspservice to hwservice_manager and allow it to be discovered.
# hal_attribute_hwservice() expanded: the QSSI policy makes isolated_compute_app
# a vendor_hal_dspmanager client, and isolated app types may not look up
# hwservices (system/sepolicy/tests: TestIsolatedAttributeConsistency).
allow { vendor_hal_dspmanager_client -isolated_app_all } vendor_hal_dspmanager_hwservice:hwservice_manager find;
add_hwservice(vendor_hal_dspmanager_server, vendor_hal_dspmanager_hwservice)
neverallow { domain -vendor_hal_dspmanager_client -vendor_hal_dspmanager_server } vendor_hal_dspmanager_hwservice:hwservice_manager find;

# Isolated compute processes reach the DSP through the AIDL service only.
typeattribute vendor_hal_dspmanager_aidlservice isolated_compute_allowed_service;
